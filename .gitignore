# Generated by running flutter/firebase at the repository root by mistake.
# The real folders live under 1_app_development/.
/android/
/ios/
/firebase/
/build/

# Play upload key and its passwords (23번 6단계). Keep the keystore outside the
# repository (e.g. C:\keys\); these patterns catch accidental copies.
key.properties
*.jks
*.keystore
*.aab

# Online build keys passed with --dart-define-from-file (23번 7단계). Only the
# empty example is committed; the real online.json stays on this PC.
/1_app_development/dart_defines/*
!/1_app_development/dart_defines/online.example.json
# Which Firebase project this PC deploys to (firebase_local.cmd use --add).
/1_app_development/firebase/.firebaserc

# Android build output when gradle runs inside android/ (26번 0단계 예방).
/1_app_development/android/build/

