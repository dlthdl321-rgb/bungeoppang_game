<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) when the OS's Dark Mode setting is on. The system
         splash screen ignores windowBackground and shows the launcher icon on
         white unless told otherwise (26번 3차 H1): the bungeoppang mold
         (drawable-nodpi/splash_icon.png, the same art as splash.png) in a
         cream circle on the stall's dark wood colour, like the older splash.
         It stays until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF68311F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFEF1D6</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
